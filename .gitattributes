# Normalize line endings: LF in the repo, LF in the working tree
* text=auto eol=lf

# SVG is text (XML)
*.svg text eol=lf

# Binary files: never touched by EOL conversion or diffed as text
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.sqlite binary
*.db binary
