# PUBLIC values only: anything VITE_* is shipped to browsers. Secrets go in wrangler secrets, never here.
# Optional. The committed Turnstile site key (packages/contract) is used when this is unset.
# Local dev: Cloudflare's always-passes TEST site key (pair it with the test secret 1x0000000000000000000000000000000AA in apps/api/.dev.vars).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
