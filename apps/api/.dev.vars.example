# Copy to .dev.vars (gitignored). Real Google sign-in only works on production (the only registered redirect URI),
# so locally these are placeholders and sign-in reports not_configured unless OAUTH_REDIRECT_URI is also set.
# Production values are set by the user with `wrangler secret put`, never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# Slice 30: Cloudflare Turnstile always-pass TEST secret (local only; the site key in the web .env.local is 1x00000000000000000000AA).
# Leave RESEND_API_KEY empty locally: nothing is sent and email_status becomes "skipped". NOTIFY_* come from wrangler.toml.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
RESEND_API_KEY=
